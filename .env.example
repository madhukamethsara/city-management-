# Pass these values with --dart-define or your CI/CD secret manager.
# auto selects demo only when both Supabase settings are empty.
AUTH_MODE=auto
SUPABASE_URL=
SUPABASE_ANON_KEY=
MAP_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Native default: lk.smartsabha.app://auth-callback; web default: current app URL.
AUTH_REDIRECT_URL=
